<div
  id={@id}
  class={class(@style, :container, @container_class, @container_extra_class)}
  phx-hook="LiveSelect"
  phx-target={@myself}
  data-phx-target={assigns[:"phx-target"]}
  data-update-min-len={@update_min_len}
  data-field={@field.id}
  data-debounce={@debounce}
  data-selection-revision={@selection_revision}
>
  <div
    :if={@mode in [:tags, :quick_tags] && Enum.any?(@selection)}
    class={class(@style, :tags_container, @tags_container_class, @tags_container_extra_class)}
  >
    <div
      :for={{option, idx} <- Enum.with_index(@selection)}
      class={class(@style, :tag, @tag_class, @tag_extra_class)}
    >
      <div>
        <%= if @tag == [] do %>
          {option[:tag_label] || option[:label]}
        <% else %>
          {render_slot(@tag, option)}
        <% end %>
      </div>
      <button
        :if={!option[:sticky] && !@disabled}
        type="button"
        data-idx={idx}
        phx-click="option_remove"
        phx-target={@myself}
        phx-value-idx={idx}
        aria-label="Remove selection"
        class={
          class(
            @style,
            :clear_tag_button,
            @clear_tag_button_class,
            @clear_tag_button_extra_class
          ) ++
            if @no_basic_styles_for_clear_buttons,
              do: [],
              else: ~w(ls-clear-tag-button)
        }
      >
        <%= if @clear_button == [] do %>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            width="20"
            height="20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
          </svg>
        <% else %>
          {render_slot(@clear_button)}
        <% end %>
      </button>
    </div>
  </div>

  <div class={unless @no_basic_styles_for_clear_buttons, do: "ls-input-container"}>
    <input
      type="text"
      id={Phoenix.HTML.Form.input_id(@field.form, "#{@field.field}_text_input")}
      name={Phoenix.HTML.Form.input_name(@field.form, "#{@field.field}_text_input")}
      class={
        class(@style, :text_input, @text_input_class, @text_input_extra_class) ++
          List.wrap(
            if Enum.any?(@selection),
              do: class(@style, :text_input_selected, @text_input_selected_class)
          ) ++
          if @no_basic_styles_for_clear_buttons,
            do: [],
            else: ~w(ls-text-input)
      }
      placeholder={@placeholder}
      phx-target={@myself}
      phx-change={%Phoenix.LiveView.JS{}}
      disabled={@disabled}
      autocomplete="off"
      phx-focus="focus"
      phx-click="click"
      phx-blur="blur"
      value={
        case {@mode, @selection} do
          {:single, [option | _]} -> to_string(option[:selected_label] || option.label)
          _ -> ""
        end
      }
    />
    <button
      :if={@mode == :single && @allow_clear && !@disabled && Enum.any?(@selection)}
      type="button"
      phx-click="clear"
      phx-target={@myself}
      aria-label="Clear selection"
      class={
        class(@style, :clear_button, @clear_button_class, @clear_button_extra_class) ++
          if @no_basic_styles_for_clear_buttons,
            do: [],
            else: ~w(ls-clear-button)
      }
    >
      <%= if @clear_button == [] do %>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          width="20"
          height="20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
        </svg>
      <% else %>
        {render_slot(@clear_button)}
      <% end %>
    </button>
  </div>
  <%= if @mode == :single do %>
    <input
      type="hidden"
      id={@field.id}
      name={@field.name}
      disabled={@disabled}
      class="single-mode"
      value={
        case @selection do
          [%{value: nil} | _] ->
            ""

          [%{value: value} | _] when is_atom(value) or is_binary(value) or is_number(value) ->
            to_string(value)

          [%{value: value} | _] ->
            Phoenix.json_library().encode!(value)

          [] ->
            ""
        end
      }
    />
  <% else %>
    <input
      :if={Enum.empty?(@selection)}
      type="hidden"
      name={@field.name <> "[]"}
      id={"#{@field.id}_empty_selection"}
      value=""
      disabled={@disabled}
      data-live-select-empty
    />
    <input
      :for={{option, idx} <- Enum.with_index(@selection)}
      type="hidden"
      name={@field.name <> "[]"}
      id={@field.id <> "_#{idx}"}
      disabled={@disabled}
      value={
        case option.value do
          nil -> ""
          value when is_atom(value) or is_binary(value) or is_number(value) -> to_string(value)
          value -> Phoenix.json_library().encode!(value)
        end
      }
    />
  <% end %>
  <ul
    :if={Enum.any?(@options) && !@hide_dropdown}
    class={class(@style, :dropdown, @dropdown_class, @dropdown_extra_class)}
  >
    <li
      :for={{option, idx} <- Enum.with_index(@options)}
      class={
        cond do
          Map.get(option, :disabled, false) ->
            class(@style, :unavailable_option, @unavailable_option_class)

          @mode in [:tags, :quick_tags] &&
              Enum.any?(@selection, &(&1.label == option.label && &1[:sticky])) ->
            class(@style, :unavailable_option, @unavailable_option_class)

          Enum.any?(@selection, &(&1.label == option.label)) ->
            class(@style, :selected_option, @selected_option_class)

          @max_selectable > 0 && length(@selection) >= @max_selectable ->
            class(@style, :unavailable_option, @unavailable_option_class)

          true ->
            class(@style, :available_option, @available_option_class)
        end
      }
    >
      <div
        class={
          class(@style, :option, @option_class, @option_extra_class) ++
            List.wrap(
              if idx == @active_option,
                do: class(@style, :active_option, @active_option_class)
            )
        }
        data-idx={
          case Enum.find(@selection, &(&1.label == option.label)) do
            nil -> idx
            selected -> if @mode == :quick_tags && !selected[:sticky], do: idx
          end
        }
      >
        <%= if @option == [] do %>
          {option.label}
        <% else %>
          {render_slot(
            @option,
            Map.put(option, :selected, Enum.any?(@selection, &(&1.label == option.label)))
          )}
        <% end %>
      </div>
    </li>
  </ul>
</div>
